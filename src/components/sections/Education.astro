---
import { education } from '../../utils/constants';
---

<section id="education" class="w-full py-20 relative border-neon-cyan/20">
    <div class="max-w-6xl mx-auto px-6 md:px-10 mb-12 text-center">
        <h2 class="text-subtitle text-neon-cyan mb-4">Education</h2>
        <p class="text-body text-primary max-w-2xl mx-auto">
            My academic background and certifications.
        </p>
    </div>
    <div class="max-w-6xl mx-auto px-6 md:px-10 space-y-6">
        {
            education.map((edu) => (
                <div
                    class="bg-bg-burgundy/20 backdrop-blur-md rounded-xl p-6 md:p-10 shadow-lg hover:scale-105 transition-transform duration-300"
                >
                    <h3 class="text-subtitle text-neon-cyan mb-2">{edu.title}</h3>
                    <p class="text-body text-primary font-medium mb-1">{edu.institution}</p>
                    <p class="text-body text-text-muted mb-4">{edu.date}</p>
                    <p class="text-body text-primary mb-6">{edu.description}</p>
                    {edu.tech.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                            {edu.tech.map((tech) => (
                                <span class="px-2 py-1 rounded bg-neon-cyan/10 text-neon-cyan text-xs">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</section>